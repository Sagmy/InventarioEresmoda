# =============================================================================
# Copia este archivo como .env.local y rellena los valores de TU proyecto.
# .env.local está en .gitignore y nunca se sube al repositorio.
#
# Los encuentras en: supabase.com → tu proyecto → botón "Connect" → .env.local
# =============================================================================

# URL del proyecto. Ej: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública del proyecto. Está DISEÑADA para viajar al navegador: sin una
# sesión válida no puede leer ni escribir nada, porque toda la seguridad la
# impone Row Level Security del lado del servidor.
#
# Supabase la renombró: hoy se llama "publishable key" (sb_publishable_...) y
# antes "anon key" (eyJ...). Son la misma cosa y la aplicación acepta ambos
# nombres, así que usa el que te dé tu panel.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# NO agregues aquí la service_role key (ni la "secret key").
#
# Esa llave se salta TODA la seguridad de la base de datos. Esta aplicación no
# la necesita en ningún punto: las operaciones sensibles ya están protegidas
# dentro de Postgres. Si algún día hiciera falta, iría en una variable SIN el
# prefijo NEXT_PUBLIC_, porque cualquier variable con ese prefijo termina
# incrustada en el JavaScript que descarga el navegador.
# -----------------------------------------------------------------------------
